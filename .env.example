# Optional. Without this key, Storyloom reads stories from your words
# and from the light and colour in the photographs. Originals stay on this machine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Keep this false. Storyloom grades light and colour so people stay recognisable.
# Set to true only if you also unlock Identity in a project and accept generative edits.
STORYLOOM_GENERATIVE_EDITS=false
OPENAI_IMAGE_MODEL=gpt-image-1

# Override where projects are stored. Defaults to ./data/projects
# STORYLOOM_DATA_DIR=
